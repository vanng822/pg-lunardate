SET client_min_messages TO WARNING;
DROP TABLE IF EXISTS lunartest;
DROP EXTENSION IF EXISTS lunardate;
CREATE EXTENSION lunardate;
CREATE TABLE lunartest(
  id serial PRIMARY KEY,
  from_date lunardate,
  to_date lunardate
);
SET DateStyle=ISO;
insert into lunartest(from_date, to_date) values('2018-10-10', '2019-01-13');
insert into lunartest(from_date, to_date) values('2018-11-11', '2018-12-01');
select * from lunartest;
 id | from_date  |  to_date   
----+------------+------------
  1 | 2018-10-10 | 2019-01-13
  2 | 2018-11-11 | 2018-12-01
(2 rows)

select id, from_date as lunar_date, from_date::date as solar_date from lunartest;
 id | lunar_date | solar_date 
----+------------+------------
  1 | 2018-10-10 | 2018-11-16
  2 | 2018-11-11 | 2018-12-17
(2 rows)

select * from lunartest where from_date = '2018-11-11';
 id | from_date  |  to_date   
----+------------+------------
  2 | 2018-11-11 | 2018-12-01
(1 row)

select
  '2018-10-10'::lunardate < '2018-11-11'::lunardate as less_than,
  '2018-10-10'::lunardate <= '2018-10-10'::lunardate as less_than_or_equal,
  '2018-11-11'::lunardate > '2018-10-10'::lunardate as greater_than,
  '2018-11-11'::lunardate >= '2018-11-11'::lunardate as greater_than_or_equal,
  '2018-10-10'::lunardate <> '2018-11-11'::lunardate as not_equal;
 less_than | less_than_or_equal | greater_than | greater_than_or_equal | not_equal 
-----------+--------------------+--------------+-----------------------+-----------
 t         | t                  | t            | t                     | t
(1 row)

select id from lunartest
where from_date between '2018-10-10' and '2018-11-11'
order by id;
 id 
----
  1
  2
(2 rows)

select id from lunartest
where from_date in ('2018-10-10', '2018-12-01')
order by id;
 id 
----
  1
(1 row)

select '2018-11-11'::lunardate::date;
    date    
------------
 2018-12-17
(1 row)

select '2018-12-17'::date::lunardate;
 lunardate  
------------
 2018-11-11
(1 row)

-- issue #11: day before the leap month 6 of 2025 starts
select '2025-07-24'::date::lunardate;
 lunardate  
------------
 2025-06-30
(1 row)

select '2025-07-25'::date::lunardate;
  lunardate  
-------------
 2025-r06-01
(1 row)

select '2025-r06-01'::lunardate::date;
    date    
------------
 2025-07-25
(1 row)

select '2025-01-29'::date::lunardate;
 lunardate  
------------
 2025-01-01
(1 row)

-- dates before 2000 exercise the negative sun longitude branch
select '1990-01-01'::date::lunardate;
 lunardate  
------------
 1989-12-05
(1 row)

select '1970-02-06'::date::lunardate;
 lunardate  
